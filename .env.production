# ======================================
# El-Akeil Environment Configuration
# ======================================
# This file contains environment variables for the El-Akeil application
# Do NOT commit this file to version control!

# ========== FLASK SETTINGS ==========
FLASK_ENV=production
FLASK_DEBUG=0

# ========== SECRET KEY ==========
# Generate a new secret key:
# python3 -c "import os; print(os.urandom(32).hex())"
SECRET_KEY=your_super_secret_key_here_change_this_in_production

# ========== DATABASE ==========
# SQLite (development)
DATABASE_URL=sqlite:///data.db

# PostgreSQL (production - recommended)
# DATABASE_URL=postgresql://user:password@localhost:5432/el_akeil

# ========== API SETTINGS ==========
API_DEBUG=false
API_TIMEOUT=30

# ========== CORS SETTINGS ==========
CORS_ORIGINS=https://el-akeil.com,https://www.el-akeil.com,http://localhost:5000

# ========== PAYMENT GATEWAY ==========
# Fawry
FAWRY_MERCHANT_CODE=your_fawry_code
FAWRY_MERCHANT_KEY=your_fawry_key

# Vodafone Cash
VODAFONE_API_KEY=your_vodafone_key
VODAFONE_MERCHANT_ID=your_merchant_id

# ========== EMAIL SETTINGS ==========
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# ========== GOOGLE MAPS ==========
GOOGLE_MAPS_API_KEY=your_google_maps_key

# ========== LOGGING ==========
LOG_LEVEL=INFO
LOG_FILE=/var/log/el-akeil/app.log

# ========== SESSION ==========
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=86400

# ========== REDIS (for caching) ==========
REDIS_URL=redis://localhost:6379/0

# ========== WORKER SETTINGS ==========
WORKER_PROCESSES=4
WORKER_TIMEOUT=30
WORKER_CLASS=sync

# ========== SECURITY HEADERS ==========
SECURITY_HEADERS_ENABLED=true
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
X_XSS_PROTECTION=1; mode=block

# ========== RATE LIMITING ==========
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URL=memory://

# ========== FILE UPLOADS ==========
UPLOAD_FOLDER=/var/www/el-akeil/uploads
MAX_UPLOAD_SIZE=52428800  # 50MB

# ========== COMPRESSION ==========
GZIP_COMPRESSION=true
GZIP_LEVEL=6

# ========== SENTRY ERROR TRACKING ==========
SENTRY_DSN=

# ========== ADMIN SETTINGS ==========
ADMIN_EMAIL=admin@el-akeil.com
SUPPORT_EMAIL=support@el-akeil.com
