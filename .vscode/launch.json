{
    "version": "0.2.0",
    "configurations": [
        {"name":"Python Debugger: Current File","type":"debugpy","request":"launch","program":"${file}","console":"integratedTerminal"},
        {
            "name": "Python: Run app.py",
            "type": "python",
            "request": "launch",
            "program": "${workspaceFolder}/src/beckend/app.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/src/beckend",
            "env": {
                "FLASK_ENV": "development"
            }
        }
    ]
}